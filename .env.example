# URL kết nối cơ sở dữ liệu Postgres (Supabase cung cấp)
# Ví dụ: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Thông tin kết nối Supabase (Lấy từ Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service Role Key (Dùng cho các tác vụ server-side cần quyền admin)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Secret dùng để bảo vệ endpoint cron job tự động
CRON_SECRET="my-super-secret-cron-key"

# (Tuỳ chọn) Các domain email được phép đăng ký
# ALLOWED_EMAIL_DOMAINS="viettel.com.vn,gmail.com"

# (Tuỳ chọn) Email được tự động cấp quyền Admin
# BOOTSTRAP_ADMIN_EMAILS="admin@example.com"

# --- Ba biến dưới đây KHÔNG bắt buộc để chạy thử, nhưng bắt buộc khi
# --- đưa lên chạy thật. Xem DEPLOY.md phần 3.

# Domain email được phép đăng ký, cách nhau bằng dấu phẩy.
# ĐỂ TRỐNG LÀ MỞ CHO MỌI EMAIL — bất kỳ ai có link đều tạo được tài khoản.
# Trên bản chạy thật phải điền domain công ty vào đây.
ALLOWED_EMAIL_DOMAINS=

# Email được tự cấp quyền admin ở lần đăng nhập đầu tiên, cách nhau bằng dấu phẩy.
# Để trống thì sau khi deploy sẽ KHÔNG AI vào được trang quản trị.
BOOTSTRAP_ADMIN_EMAILS=

# Địa chỉ thật của trang, dùng cho thẻ chia sẻ (Open Graph).
# Bỏ trống thì mặc định về http://localhost:3000 và ảnh chia sẻ sẽ hỏng.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
